# Copy to .env.local and fill in. PLACEHOLDERS ONLY — never commit real secrets.
# Secret values are left EMPTY on purpose: copying this file as-is keeps every integration in demo mode.
# Everything is optional locally: without keys the site runs in demo mode.

# ---------------------------------------------------------------- site
NEXT_PUBLIC_SITE_URL=https://wesley-santos.dev

# ---------------------------------------------------------------- e-mail (Resend) — contact, quote, Órbita leads
# format: re_xxxxxxxx
RESEND_API_KEY=
# recipient of leads (default: the SITE e-mail)
CONTACT_EMAIL=
# sender; must be a verified Resend domain in production (default onboarding@resend.dev)
RESEND_FROM_EMAIL=

# ---------------------------------------------------------------- Órbita · AI chat (Gemini or Claude)
# Without a model key the widget runs the scripted demo conversation (v3spec §8.3).
# Gemini: Google AI Studio key (https://aistudio.google.com/apikey). Wins over ANTHROPIC_API_KEY when both are set.
GEMINI_API_KEY=
# default gemini-flash-latest
GEMINI_MODEL=
# force one engine: gemini | anthropic (default: whichever key exists, Gemini first)
ORBITA_PROVIDER=
# Claude: API key from console.anthropic.com (a Claude subscription OAuth token cannot back a public chatbot)
# format: sk-ant-xxxxxxxx
ANTHROPIC_API_KEY=
# model override (default claude-opus-5-5 — best quality). Cheaper: claude-sonnet-5-5 (~2x cheaper)
# or claude-haiku-4-5 (~4x cheaper; no adaptive thinking/effort — ORBITA_EFFORT is ignored).
# Prices per 1M tokens in/out: Opus 5.5 $4/$20 · Sonnet 5.5 $2/$10 · Haiku 4.5 $1/$5.
ORBITA_MODEL=
# low | medium | high | xhigh | max (default low — chat route, latency-sensitive)
ORBITA_EFFORT=low
# max output tokens per model call, thinking included (default 8000)
ORBITA_MAX_TOKENS=8000
# server-side refusal fallback ("fallbacks": "default"); set to off behind proxies that reject the beta
ORBITA_FALLBACKS=on
# per-IP chat limits (in-memory, per server instance)
ORBITA_RATE_CHAT_PER_MIN=8
ORBITA_RATE_CHAT_PER_HOUR=60

# ---------------------------------------------------------------- Órbita · booking (Google Calendar)
# Without Google credentials + WESLEY_CALENDAR_ID, slots/book return demo data (mode "demo") and write nothing.
# Calendar to read free/busy from and to book into
# e.g. you@gmail.com or xxxx@group.calendar.google.com
WESLEY_CALENDAR_ID=
# aprovacao (default) = tentative hold on the calendar + e-mail to Wesley (Resend); nobody is invited
# auto = event with the visitor as attendee + Google Meet, invite sent
ORBITA_BOOKING_MODE=aprovacao
ORBITA_TIMEZONE=America/Sao_Paulo
# 0 = Sunday … 6 = Saturday; "1-5" or "1,2,3,4,5"
ORBITA_WORK_DAYS=1-5
# one or more windows, comma separated (e.g. with a lunch break: 09:00-12:00,13:30-18:00)
ORBITA_WORK_HOURS=09:00-18:00
ORBITA_SLOT_MINUTES=30
ORBITA_LOOKAHEAD_DAYS=10
ORBITA_MIN_NOTICE_HOURS=24
ORBITA_BUFFER_MINUTES=0
# where Órbita lead e-mails go (default CONTACT_EMAIL)
ORBITA_NOTIFY_EMAIL=

# Google auth — option A (recommended for a personal @gmail.com calendar): OAuth refresh token of the
# calendar owner, scopes calendar.freebusy + calendar.events. Required to invite attendees and create Meet links.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Google auth — option B: service account (Workspace). Needs domain-wide delegation (GOOGLE_IMPERSONATE_USER)
# to send invitations / create Meet links; without it, it can only read free/busy of a calendar shared with it.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# PEM with literal \n line breaks
GOOGLE_PRIVATE_KEY=
GOOGLE_IMPERSONATE_USER=
